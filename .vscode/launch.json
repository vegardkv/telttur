{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "telttur generate (mini, debug-buildings)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/telttur",
            "args": ["generate", "--config", "config_mini.yaml", "--debug-buildings"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
